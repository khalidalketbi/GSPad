+static constexpr size_t navPadFrameLimit = 24;
+static constexpr unsigned long navPadFreshMS = 2500;
+static uint32_t navPadSequence = 0;
+static struct NavPadFrame
+{
+  unsigned long receivedAt;
+  uint32_t sequence;
+  uint8_t size;
+  uint8_t source;
+  uint8_t bytes[73]; // MSPv2 envelope + CRSF's maximum 64-byte frame.
+} navPadFrames[navPadFrameLimit];
+
+static void CaptureNavPadTelemetry(const uint8_t *data, uint16_t size)
+{
+  if (size < 13 || size > sizeof(navPadFrames[0].bytes) ||
+      data[0] != '$' || data[1] != 'X' || (data[2] != '<' && data[2] != '>') ||
+      data[4] != 0x11 || data[5] != 0 || data[6] != size - 9 ||
+      data[7] != 0 || data[9] != size - 11)
+  {
+    return;
+  }
+
+  const uint8_t type = data[10];
+  uint8_t source = 0;
+  switch (type)
+  {
+    case 0x08: // Battery, with optional sensor ID after the standard payload.
+      if (size < 21) return;
+      source = size > 21 ? data[19] : 0;
+      break;
+    case 0x0C: // RPM
+    case 0x0D: // Temperature
+    case 0x0E: // Voltage group
+      if (size < 14) return;
+      source = data[11];
+      break;
+    case 0x02: case 0x06: case 0x07: case 0x09: case 0x0A: case 0x11:
+    case 0x14: case 0x1C: case 0x1D: case 0x1E: case 0x21: case 0x23:
+      break;
+    default:
+      return;
+  }
+
+  const unsigned long now = millis();
+  NavPadFrame *slot = nullptr;
+  for (auto &frame : navPadFrames)
+  {
+    if (frame.size && frame.bytes[10] == type && frame.source == source)
+    {
+      slot = &frame;
+      break;
+    }
+    if (slot == nullptr && (!frame.size || now - frame.receivedAt > navPadFreshMS))
+    {
+      slot = &frame;
+    }
+  }
+  if (slot != nullptr)
+  {
+    memcpy(slot->bytes, data, size);
+    slot->source = source;
+    slot->size = size;
+    slot->receivedAt = now;
+    slot->sequence = ++navPadSequence;
+  }
+}
+
+static void HandleNavPadTelemetry(AsyncWebServerRequest *request)
+{
+  const bool gpsOnly = request->url() == "/navpad/gps";
+  const bool timed = request->url() == "/navpad/telemetry/v3";
+  AsyncWebServerResponse *response;
+  if (wifiMode != WIFI_AP || wifiService != WIFI_SERVICE_MAVLINK_TX)
+  {
+    response = request->beginResponse(503, "text/plain", "Enable WiFi telemetry on the Backpack access point");
+  }
+  else
+  {
+    static constexpr char hex[] = "0123456789abcdef";
+    String body;
+    const unsigned long now = millis();
+    for (auto &frame : navPadFrames)
+    {
+      const unsigned long age = now - frame.receivedAt;
+      if (frame.size && age > navPadFreshMS) frame.size = 0;
+      if (!frame.size || (gpsOnly && (frame.size != 28 || frame.bytes[10] != 0x02))) continue;
+
+      char encoded[sizeof(frame.bytes) * 2 + 1];
+      for (size_t i = 0; i < frame.size; ++i)
+      {
+        encoded[i * 2] = hex[frame.bytes[i] >> 4];
+        encoded[i * 2 + 1] = hex[frame.bytes[i] & 15];
+      }
+      encoded[frame.size * 2] = '\0';
+      char metadata[24] = {};
+      if (timed) snprintf(metadata, sizeof(metadata), ";%lu;%lu", age, static_cast<unsigned long>(frame.sequence));
+      if ((!body.isEmpty() && !body.concat('\n')) || !body.concat(encoded) || (timed && !body.concat(metadata)))
+      {
+        request->send(503);
+        return;
+      }
+    }
+    response = body.isEmpty() ? request->beginResponse(204) : request->beginResponse(200, "text/plain", body);
+  }
+  response->addHeader("Cache-Control", "no-store");
+  response->addHeader("X-NavPad-Backpack", gpsOnly ? "1" : timed ? "3" : "2");
+  request->send(response);
+}
+#endif
